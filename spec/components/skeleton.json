{
  "$schema": "../schema.json",
  "name": "Skeleton",
  "layer": "feedback",
  "purpose": "A placeholder for content whose shape is already known.",
  "notFor": [
    "Waits with no known shape — use StateBlock state=\"loading\""
  ],
  "composition": "composite",
  "anatomy": [
    {
      "part": "bh-skeleton",
      "element": "span",
      "required": false
    }
  ],
  "props": {
    "width": {
      "kind": "data",
      "default": "100%"
    },
    "height": {
      "kind": "data",
      "default": 16
    },
    "radius": {
      "kind": "enum",
      "values": [
        "control",
        "field",
        "surface",
        "pill"
      ],
      "default": "control"
    },
    "animated": {
      "kind": "boolean",
      "default": true,
      "note": "Shimmer is off under prefers-reduced-motion regardless."
    },
    "label": {
      "kind": "string",
      "note": "On SkeletonGroup."
    }
  },
  "states": [
    "default"
  ],
  "keyboard": {},
  "aria": {
    "role": "status",
    "attributes": {
      "aria-hidden": "true"
    },
    "labelling": null,
    "focus": null,
    "announcements": "The live region mounts empty and receives its words one render later, so a screen reader announces them; no aria-busy."
  },
  "implementations": {
    "version": "3.2.0",
    "status": "react-only"
  },
  "tokensUsed": [
    "duration.sweep",
    "radius.control",
    "radius.pill",
    "radius.surface",
    "surface.base",
    "radius.field",
    "fill.hover"
  ],
  "interactive": false
}
