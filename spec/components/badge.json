{
  "$schema": "../schema.json",
  "name": "Badge",
  "layer": "feedback",
  "purpose": "Short status attached to an object.",
  "notFor": [
    "Bare counts",
    "Anything clickable"
  ],
  "composition": "leaf",
  "anatomy": [
    {
      "part": "bh-badge",
      "element": "span"
    },
    {
      "part": "bh-badge__dot",
      "element": "span"
    }
  ],
  "props": {
    "tone": {
      "kind": "tone",
      "values": [
        "neutral",
        "info",
        "success",
        "warning",
        "critical"
      ],
      "default": "neutral"
    },
    "dot": {
      "kind": "boolean",
      "default": false,
      "note": "Decorative. The label still carries the meaning."
    },
    "children": {
      "kind": "slot",
      "note": "Required by design — colour alone fails WCAG 1.4.1.",
      "content": "TODO"
    }
  },
  "states": [
    "default"
  ],
  "keyboard": {},
  "aria": {
    "role": "TODO"
  },
  "implementations": {
    "version": "3.2.0",
    "status": "react-only"
  },
  "tokensUsed": [
    "font.family",
    "gap.hairline",
    "gap.tight",
    "padding.block",
    "status.critical.bg",
    "status.critical.fg",
    "status.info.bg",
    "status.info.fg",
    "status.success.bg",
    "status.success.fg",
    "status.warning.bg",
    "status.warning.fg",
    "text.secondary",
    "text.weightEmphasis",
    "fill.hover",
    "border.hairline",
    "radius.tag"
  ],
  "interactive": false
}
