{
  "$schema": "../schema.json",
  "name": "Pagination",
  "layer": "frame",
  "purpose": "Paging over a set too large to render. Reports a range and a total, because '21–40 of 312' is a fact about the data and 'page 2 of 16' is a fact about the component.",
  "notFor": [
    "Infinite scroll",
    "Fewer rows than one page holds — then show them all"
  ],
  "composition": "composite",
  "anatomy": [
    {
      "part": "bh-pagination",
      "element": "nav"
    },
    {
      "part": "bh-pagination__summary",
      "element": "p"
    },
    {
      "part": "bh-pagination__size",
      "element": "div"
    },
    {
      "part": "bh-pagination__controls",
      "element": "div"
    }
  ],
  "props": {
    "page": {
      "kind": "number",
      "note": "Zero-based, so it indexes the data without arithmetic at the call site."
    },
    "pageSize": {
      "kind": "number"
    },
    "total": {
      "kind": "number",
      "note": "Rows in the whole set. Omit for a cursor-paged endpoint that does not know."
    },
    "onPageChange": {
      "kind": "event"
    },
    "pageSizeOptions": {
      "kind": "data",
      "note": "Omit to hide the size control."
    },
    "onPageSizeChange": {
      "kind": "event"
    },
    "unit": {
      "kind": "string",
      "default": "results",
      "note": "What is counted: 'invoices', 'documents'."
    },
    "busy": {
      "kind": "boolean",
      "default": false,
      "note": "Disables both controls while a request is in flight."
    }
  },
  "states": [
    "default"
  ],
  "keyboard": {},
  "aria": {
    "role": "navigation (implicit, from <nav>)",
    "attributes": {
      "aria-label": "Pagination",
      "aria-live": "polite"
    },
    "labelling": null,
    "focus": null,
    "announcements": null
  },
  "implementations": {
    "version": "3.2.0",
    "status": "react-only"
  },
  "tokensUsed": [
    "font.family",
    "gap.loose",
    "gap.snug",
    "padding.block",
    "padding.inline",
    "text.muted",
    "text.secondary",
    "text.sizeBody"
  ],
  "interactive": true
}
