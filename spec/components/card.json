{
  "$schema": "../schema.json",
  "name": "Card",
  "layer": "frame",
  "purpose": "A bounded surface around content the user might act on as a unit.",
  "notFor": ["A paragraph — that is a border with extra steps", "Cards with two actions inside"],
  "composition": "composite",
  "anatomy": [
    {
      "part": "bh-card",
      "element": "TODO",
      "note": "TODO: read it off the React render"
    },
    {
      "part": "bh-card__body",
      "element": "div",
      "required": false
    },
    {
      "part": "bh-card__actions",
      "element": "div",
      "required": false
    }
  ],
  "props": {
    "children": {
      "kind": "slot",
      "content": "TODO"
    },
    "onClick": {
      "kind": "event",
      "note": "Makes the whole surface one button."
    },
    "ariaLabel": {
      "kind": "string",
      "note": "Its accessible name when onClick is set."
    },
    "elevation": {
      "kind": "enum",
      "values": ["flat", "raised"],
      "default": "raised"
    },
    "accent": {
      "kind": "enum",
      "values": ["none", "info", "success", "warning", "critical"],
      "default": "none",
      "note": "Decorative — never the only carrier of a status. An accented card takes section padding on its leading side to make room for the bar."
    },
    "padding": {
      "kind": "enum",
      "values": ["snug", "normal"],
      "default": "normal"
    },
    "dragging": {
      "kind": "boolean",
      "default": false
    },
    "actions": {
      "kind": "slot",
      "content": "Buttons; primary last",
      "note": "A row at the foot, trailing edge. Never together with onClick: a card that is a button cannot hold buttons.",
      "react": "actions?: ReactNode (never with onClick)"
    }
  },
  "states": ["default", "hover"],
  "keyboard": {},
  "aria": {
    "role": "TODO"
  },
  "implementations": {
    "version": "3.2.0",
    "status": "react-only"
  },
  "tokensUsed": [
    "elevation.overlay",
    "elevation.raised",
    "font.family",
    "padding.inline",
    "padding.section",
    "radius.surface",
    "status.critical.fg",
    "status.info.fg",
    "status.success.fg",
    "status.warning.fg",
    "surface.raised",
    "text.primary",
    "border.hairline",
    "duration.normal",
    "easing.standard",
    "elevation.floating",
    "radius.pill",
    "gap.normal",
    "gap.snug"
  ],
  "interactive": true
}
