{
  "name": "@bighat/ui",
  "version": "3.2.0",
  "description": "A small, opinionated React design system: two token layers, eight value classes that cannot be literals, WCAG AA enforced in CI, and contracts an agent can read.",
  "license": "MIT",
  "author": "Konstancja Tanjga-Nawrot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konstancja-Tanjga/bighat-design-system.git"
  },
  "homepage": "https://konstancja-tanjga.github.io/bighat-design-system/",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "react",
    "accessibility",
    "wcag",
    "aria",
    "storybook"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "spec",
    "agent",
    "MIGRATION.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tokens": "./dist/tokens.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.scss": "./dist/tokens.scss",
    "./spec/*": "./spec/*",
    "./agent/*": "./agent/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "dev": "npm run tokens && storybook dev -p 6006",
    "build": "npm run tokens && tsc -b && vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "audit:drift": "node scripts/audit-drift.mjs src/styles > DRIFT-REPORT.md",
    "aria": "node scripts/audit-aria.mjs src > ARIA.md",
    "spec:validate": "node scripts/validate-spec.mjs",
    "spec:extract": "node scripts/extract-contract.mjs src src/styles",
    "check:docs": "node scripts/check-docs.mjs src",
    "docs:generate": "node scripts/generate-doc-pages.mjs",
    "docs:check": "node scripts/generate-doc-pages.mjs --check",
    "storybook": "npm run docs:generate && storybook dev -p 6006",
    "build-storybook": "npm run tokens && npm run docs:generate && storybook build -o storybook-static",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run tokens:check && npm run spec:validate && npm run audit:drift && npm run aria && npm run docs:check && npm test && npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
